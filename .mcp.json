{
    "mcpServers": {
        "laravel-boost": {
            "args": [
                "artisan",
                "boost:mcp"
            ],
            "command": "php"
        },
        "lerd": {
            "args": [
                "mcp"
            ],
            "command": "lerd"
        },
        "motion": {
            "type": "http",
            "url": "https://mcp.motion.dev"
        },
        "motion-plus": {
            "type": "http",
            "url": "https://mcp.motion.dev/plus"
        }
    }
}
