APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

POSTHOG_PROJECT_TOKEN=your_posthog_project_token
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_DISABLED=false

# Public marketing origin; defaults to APP_URL. Private app hosts use standard routes.
# MARKETING_URL=https://birdcar.dev
# Defaults to true only when APP_ENV=production.
# MARKETING_INDEXABLE=false

ADMIN_URL=https://admin.birdcar.dev

# Publishing uses Laravel AI SDK agents with the native OpenRouter provider.
# Production setup: docs/production-setup.md
# Keep disabled until model/provider, limits and current USD prices are verified.
# Local setup: php artisan migrate; php artisan config:clear
# Run: php artisan queue:work --timeout=600 --tries=1
# Run separately: php artisan schedule:work
# Queue retry_after must exceed the worker timeout (also configure Redis/Horizon if used).
DB_QUEUE_RETRY_AFTER=660
PUBLISHING_AGENTS_ENABLED=false
PUBLISHING_AGENTS_HTTP_TIMEOUT=30
# Public writing always uses published database releases; import the archive first.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Choose an OpenRouter model supporting structured output and tool calling.
# PROVIDER is the exact upstream provider name, not "openrouter".
PUBLISHING_AGENTS_DEFAULT_MODEL=
PUBLISHING_AGENTS_DEFAULT_PROVIDER=
PUBLISHING_AGENTS_DEFAULT_MAX_COMPLETION_TOKENS=
PUBLISHING_AGENTS_DEFAULT_CONTEXT_TOKENS=
PUBLISHING_AGENTS_DEFAULT_PROMPT_PRICE=
PUBLISHING_AGENTS_DEFAULT_COMPLETION_PRICE=
# Use USD per token, or per_million for USD per million tokens. Do not mix units.
PUBLISHING_AGENTS_DEFAULT_PRICE_UNIT=per_million
# Optional separate fact-review route: leave MODEL blank to use the default route.
# If enabled, every premium limit/price/provider field below is required.
PUBLISHING_AGENTS_PREMIUM_MODEL=
PUBLISHING_AGENTS_PREMIUM_PROVIDER=
PUBLISHING_AGENTS_PREMIUM_MAX_COMPLETION_TOKENS=
PUBLISHING_AGENTS_PREMIUM_CONTEXT_TOKENS=
PUBLISHING_AGENTS_PREMIUM_PROMPT_PRICE=
PUBLISHING_AGENTS_PREMIUM_COMPLETION_PRICE=
PUBLISHING_AGENTS_PREMIUM_PRICE_UNIT=per_million
PUBLISHING_AGENTS_REVIEW_FACTS_ROUTE=premium
# Research uses OpenRouter's Exa web plugin; no separate EXA_API_KEY is needed.
